{
  "name": "portaterm",
  "displayName": "Portaterm",
  "description": "Run a real terminal anywhere in VS Code or Cursor — Primary Sidebar, Secondary Sidebar, bottom Panel, or as an editor tab. With tabs, split panes, theming, and WebGL rendering.",
  "version": "0.27.0",
  "publisher": "mhd",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MehmetHuseyinDelipalta/portaterm"
  },
  "bugs": {
    "url": "https://github.com/MehmetHuseyinDelipalta/portaterm/issues"
  },
  "homepage": "https://portaterm.mhd.dev/",
  "keywords": [
    "terminal",
    "xterm",
    "sidebar",
    "secondary sidebar",
    "panel",
    "editor terminal",
    "split",
    "tabs",
    "shell",
    "cursor",
    "node-pty",
    "webgl",
    "anywhere",
    "ai",
    "ai agent",
    "coding agent",
    "claude code",
    "codex",
    "opencode",
    "windsurf",
    "antigravity"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:portaterm.sidebar",
    "onView:portaterm.panel",
    "onCommand:portaterm.newTerminalInEditor",
    "onCommand:portaterm.newTerminal",
    "onCommand:portaterm.focusSidebar",
    "onCommand:portaterm.focusPanel",
    "onCommand:portaterm.moveToSecondary",
    "onCommand:portaterm.splitHorizontal",
    "onCommand:portaterm.splitVertical",
    "onCommand:portaterm.closeSplitPane",
    "onCommand:portaterm.renameTab",
    "onWebviewPanel:portaterm.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Portaterm",
      "properties": {
        "portaterm.shell.macOS": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Custom shell path for macOS. Leave empty to auto-detect (VS Code's resolved default shell, then $SHELL → /bin/zsh → /bin/bash → /bin/sh)."
        },
        "portaterm.shell.linux": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Custom shell path for Linux. Leave empty to auto-detect (VS Code's resolved default shell, then $SHELL → /bin/bash → /bin/sh)."
        },
        "portaterm.shell.windows": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Custom shell path for Windows. Leave empty to auto-detect (VS Code's resolved default shell, then %ComSpec% → cmd.exe)."
        },
        "portaterm.shell.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Custom shell arguments. Leave empty to use defaults (e.g., --login for zsh/bash)."
        },
        "portaterm.scrollback": {
          "type": "number",
          "default": 10000,
          "description": "Maximum number of lines in the scrollback buffer."
        },
        "portaterm.sessionRestore.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Restore terminal scrollback and metadata across VS Code restarts. NOTE: the persisted scrollback is plaintext on disk — anything echoed in the terminal (passwords typed at prompts, .env file contents, API tokens, kubeconfigs) lands in <storageUri>/snapshots until the per-snapshot caps evict it. Use Cmd+K (clear) before sensitive output, or set this to false to opt out entirely."
        },
        "portaterm.worktree.rowActivation": {
          "type": "string",
          "enum": [
            "focus",
            "preview"
          ],
          "enumDescriptions": [
            "Reveal the agent's terminal pane and make it active.",
            "Open the agent's session preview overlay."
          ],
          "default": "focus",
          "description": "What activating an agent row in the Worktree panel does. External agent rows always open their session preview, because they have no pane in this window to focus."
        },
        "portaterm.worktree.createRoot": {
          "type": "string",
          "default": ".claude/worktrees",
          "description": "Where new worktrees are created. A relative path is resolved against the repository's main worktree. Leave unset to use the layout this repository's existing worktrees already follow, falling back to .claude/worktrees when there is none."
        },
        "portaterm.cursorAgent.hooks.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Enable observational Cursor Agent hooks on this machine. Hooks are fail-open and only report terminal activity."
        },
        "portaterm.agentHooks.claude.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Enable observational Claude Code hooks on this machine. Enabling reconciles a managed entry in the currently resolved Claude settings.json and has Claude Code post each hook event to a local loopback port; disabling reconciles that same current destination only. Hooks are fail-open. Authenticated Claude Code session identity and activity are surfaced in the terminal and worktree UI."
        },
        "portaterm.agentHooks.claudeConfigDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the directory holding the Claude settings.json to install hooks into. A relative path is ignored. Leave empty to use CLAUDE_CONFIG_DIR, or ~/.claude when that is unset."
        },
        "portaterm.opencode.hooks.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Let OpenCode report which session each terminal is running, so its worktree row is named. Reporting is fail-open, sends only the session id, and never touches your own OpenCode configuration."
        },
        "portaterm.fileSearch.maxResults": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of files returned by the workspace-wide search fallback when clicking a path. The QuickPick disambiguation UI degrades past ~50 — bump higher if you regularly see truncated lists. Expert-only: values above ~200 with no workspace open and a deep cwd can stress the file search; the 2-second timeout will cancel it but you may see brief stalls."
        },
        "portaterm.fontSize": {
          "type": "number",
          "default": 0,
          "description": "Font size in pixels. Set to 0 to inherit from VS Code (terminal.integrated.fontSize → editor.fontSize → 14)."
        },
        "portaterm.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family for the terminal. Leave empty to inherit from VS Code (terminal.integrated.fontFamily → editor.fontFamily → monospace)."
        },
        "portaterm.cursorBlink": {
          "type": "boolean",
          "default": true,
          "description": "Whether the terminal cursor should blink."
        },
        "portaterm.defaultCwd": {
          "type": "string",
          "default": "",
          "description": "Default working directory for new terminals. Leave empty to use workspace root or home directory."
        },
        "portaterm.hoverPreview.delay": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "description": "Debounce in milliseconds before the hover preview popup fetches the file. Lower = snappier, higher = less I/O on incidental mouse-over."
        },
        "portaterm.hoverPreview.blockSensitive": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Block auto-preview for dotfiles (.env, .bashrc), known-sensitive folders (.git, .ssh, .aws, node_modules), and files outside the workspace. The user can press Cmd (macOS) / Ctrl (Win/Linux) during the hover to override. Application-scoped: a hostile workspace cannot disable this trust policy via .vscode/settings.json."
        },
        "portaterm.fileTree.autoReveal": {
          "type": [
            "boolean",
            "string"
          ],
          "enum": [
            true,
            false,
            "focusNoScroll"
          ],
          "default": true,
          "description": "When enabled, the file tree highlights the file currently focused in the editor. Use 'focusNoScroll' to select without scrolling."
        },
        "portaterm.fileTree.autoRevealExclude": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "when": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "default": {
            "**/node_modules": true,
            "**/bower_components": true
          },
          "description": "Glob patterns whose matching files (or any ancestor folder) are excluded from auto-reveal. Keys are glob patterns; values are true to exclude, false to disable a pattern. VS Code-style 'when'-condition objects are accepted (so settings copied from explorer.autoRevealExclude validate cleanly) but treated as 'true' — full 'when' evaluation is not honored in this version."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "portaterm",
          "title": "Portaterm",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
