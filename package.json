    "menus": {
      "view/title": [
        {
          "command": "portaterm.newTerminal.sidebar",
          "when": "view == portaterm.sidebar",
          "group": "navigation"
        },
        {
          "command": "portaterm.newTerminal.panel",
          "when": "view == portaterm.panel",
          "group": "navigation"
        },
        {
          "command": "portaterm.splitVertical.sidebar",
          "when": "view == portaterm.sidebar",
          "group": "navigation"
        },
        {
          "command": "portaterm.splitVertical.panel",
          "when": "view == portaterm.panel",
          "group": "navigation"
        },
        {
          "command": "portaterm.splitHorizontal.sidebar",
          "when": "view == portaterm.sidebar",
          "group": "navigation"
        },
        {
          "command": "portaterm.splitHorizontal.panel",
          "when": "view == portaterm.panel",
          "group": "navigation"
        },
        {
          "command": "portaterm.exportPick.sidebar",
          "when": "view == portaterm.sidebar",
          "group": "export@1"
        },
        {
          "command": "portaterm.exportPick.panel",
          "when": "view == portaterm.panel",
          "group": "export@1"
        },
        {
          "command": "portaterm.openVault.sidebar",
          "when": "view == portaterm.sidebar",
          "group": "navigation"
        },
        {
          "command": "portaterm.openVault.panel",
          "when": "view == portaterm.panel",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "portaterm.renameTab",
          "when": "webviewSection == 'terminalTab'",
          "group": "tab@1"
        },
        {
          "command": "portaterm.pinTab",
          "when": "webviewSection == 'terminalTab' && !tabPinned",
          "group": "tab@2"
        },
        {
          "command": "portaterm.unpinTab",
          "when": "webviewSection == 'terminalTab' && tabPinned",
          "group": "tab@2"
        },
        {
          "command": "portaterm.ctx.clearTerminal",
          "when": "webviewSection == 'splitPane'",
          "group": "terminal@1"
        },
        {
          "command": "portaterm.ctx.newTerminal",
          "when": "webviewSection == 'splitPane'",
          "group": "terminal@2"
        },
        {
          "command": "portaterm.ctx.killTerminal",
          "when": "webviewSection == 'splitPane'",
          "group": "terminal@3"
        },
        {
          "command": "portaterm.ctx.closePane",
          "when": "webviewSection == 'splitPane'",
          "group": "split@1"
        },
        {
          "command": "portaterm.ctx.splitVertical",
          "when": "webviewSection == 'splitPane'",
          "group": "split@2"
        },
        {
          "command": "portaterm.ctx.splitHorizontal",
          "when": "webviewSection == 'splitPane'",
          "group": "split@3"
        },
        {
          "command": "portaterm.ctx.revealInFileTree",
          "when": "webviewSection == 'splitPane'",
          "group": "navigation@1"
        },
        {
          "command": "portaterm.exportLastCommand",
          "when": "webviewSection == 'splitPane'",
          "group": "export@1"
        },
        {
          "command": "portaterm.exportCommand",
          "when": "webviewSection == 'splitPane'",
          "group": "export@2"
        },
        {
          "command": "portaterm.exportBuffer",
          "when": "webviewSection == 'splitPane'",
          "group": "export@3"
        }
      ],
      "explorer/context": [
        {
          "command": "portaterm.insertPath",
          "group": "portaterm@1"
        }
      ],
      "commandPalette": [
        {
          "command": "portaterm.ctx.clearTerminal",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.newTerminal",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.killTerminal",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.closePane",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.splitVertical",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.splitHorizontal",
          "when": "false"
        },
        {
          "command": "portaterm.ctx.revealInFileTree",
          "when": "false"
        },
        {
          "command": "portaterm.newTerminal.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.newTerminal.panel",
          "when": "false"
        },
        {
          "command": "portaterm.killTerminal.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.killTerminal.panel",
          "when": "false"
        },
        {
          "command": "portaterm.splitHorizontal.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.splitHorizontal.panel",
          "when": "false"
        },
        {
          "command": "portaterm.splitVertical.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.splitVertical.panel",
          "when": "false"
        },
        {
          "command": "portaterm.exportPick.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.exportPick.panel",
          "when": "false"
        },
        {
          "command": "portaterm.openVault.sidebar",
          "when": "false"
        },
        {
          "command": "portaterm.openVault.panel",
          "when": "false"
        },
        {
          "command": "portaterm.pinTab",
          "when": "false"
        },
        {
          "command": "portaterm.unpinTab",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "portaterm.splitVertical",
        "key": "ctrl+\\",
        "mac": "cmd+\\",
        "when": "focusedView == portaterm.sidebar || focusedView == portaterm.panel"
      },
      {
        "command": "portaterm.splitHorizontal",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\",
        "when": "focusedView == portaterm.sidebar || focusedView == portaterm.panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && pnpm run build:check-vendor && node esbuild.js --production && pnpm run build:check-requires && pnpm run build:check-size && pnpm run build:check-vsix",
    "build:check-size": "node scripts/check-bundle-size.mjs",
    "build:check-vendor": "node scripts/check-vendor-headers.mjs",
    "build:check-vsix": "node scripts/check-vsix-contents.mjs",
    "build:check-requires": "node scripts/check-bundle-requires.mjs",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "test": "vscode-test",
    "test:unit": "UV_THREADPOOL_SIZE=16 vitest run --reporter=default --reporter=./src/test/invariants/coverageReporter.ts",
    "bench:scale": "bun src/test/bench/scale.bench.ts",
    "gate:fs-deletion": "bun src/test/invariants/fsDeletionGate.ts",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "vsix": "rm -f portaterm-*.vsix && vsce package --no-dependencies",
    "install:local": "vsce package --no-dependencies -o portaterm-local.vsix && ${EDITOR_CLI:-cursor} --install-extension portaterm-local.vsix --force",
    "release": "bash scripts/release.sh",
    "asm": "bun run \"$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/../.agents/skills/asimov/scripts/asm.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@huggingface/transformers": "latest",
    "@opencode-ai/plugin": "latest",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "1.105.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.3",
    "esbuild": "^0.27.3",
    "jsdom": "^28.1.0",
    "markdown-it": "^14.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "minimatch": "^10.2.5",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.3.0",
    "shiki": "^4.1.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
